# Postgres connection used by the CLI and the case study.
DATABASE_URL=postgres://api_mirror:change-me@localhost:5432/api_mirror
# Separate database for the test suite. Tests create and drop their own schemas in it.
TEST_DATABASE_URL=postgres://api_mirror:change-me@localhost:5432/api_mirror_test
# Optional: raises the GitHub rate limit from 60 to 5000 requests/hour for the demo.
GITHUB_TOKEN=
